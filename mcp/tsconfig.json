{
	"compilerOptions": {
		"target": "es2023",
		"lib": ["es2023"],
		"module": "esnext",
		"moduleResolution": "bundler",
		"types": ["node"],
		"strict": true,
		"noUnusedLocals": true,
		"noEmit": true,
		"skipLibCheck": true,
		"verbatimModuleSyntax": true,
		"forceConsistentCasingInFileNames": true,
		// The one seam into the app: `src/lib/model/*` and `src/lib/editor/vocab.ts`
		// stay exactly where they are and are pulled in through this alias, which
		// esbuild resolves at build time from this same file.
		"paths": {
			"$lib/*": ["../src/lib/*"]
		}
	},
	"include": ["src/**/*.ts", "build.js", "vitest.config.ts"]
}
