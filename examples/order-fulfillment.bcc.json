{
  "version": 2,
  "name": "Order Fulfillment",
  "purpose": "Coordinates picking, packing and shipping once an order is paid.",
  "strategicClassification": {
    "domain": "core",
    "businessModel": "revenue",
    "evolution": "custom-built"
  },
  "domainRoles": [
    {
      "name": "execution context"
    }
  ],
  "inboundCommunication": [
    {
      "collaborator": {
        "name": "Checkout",
        "kind": "bounded-context"
      },
      "relationship": {
        "ours": "customer-supplier"
      },
      "messages": [
        {
          "type": "command",
          "name": "Place Order"
        },
        {
          "type": "event",
          "name": "Payment Confirmed",
          "description": "Triggers fulfillment."
        }
      ]
    },
    {
      "collaborator": {
        "name": "Customer Service",
        "kind": "user"
      },
      "messages": [
        {
          "type": "command",
          "name": "Cancel Fulfillment",
          "description": "Accepted until picking starts."
        },
        {
          "type": "query",
          "name": "Get Shipment Status"
        }
      ]
    },
    {
      "collaborator": {
        "name": "Warehouse",
        "kind": "external-system"
      },
      "relationship": {
        "theirs": "big-ball-of-mud",
        "ours": "anticorruption-layer"
      },
      "messages": [
        {
          "type": "event",
          "name": "Order Picked"
        },
        {
          "type": "event",
          "name": "Order Packed"
        }
      ]
    }
  ],
  "ubiquitousLanguage": [
    {
      "term": "Shipment",
      "definition": "A physical parcel dispatched against an order."
    },
    {
      "term": "Pick List",
      "definition": "The items to gather from the warehouse for one order."
    },
    {
      "term": "Backorder",
      "definition": "A paid order held until stock returns."
    },
    {
      "term": "Dispatch Cutoff",
      "definition": "The daily deadline for a paid order to leave the same day."
    }
  ],
  "businessDecisions": [
    {
      "name": "No partial shipments",
      "description": "An order ships complete or not at all."
    },
    {
      "name": "Cancellation stops at picking",
      "description": "Once picking starts, a cancellation becomes a return."
    },
    {
      "name": "Same-day before the cutoff",
      "description": "Orders paid before the dispatch cutoff leave the same day."
    }
  ],
  "outboundCommunication": [
    {
      "collaborator": {
        "name": "Warehouse",
        "kind": "external-system"
      },
      "relationship": {
        "theirs": "big-ball-of-mud",
        "ours": "anticorruption-layer"
      },
      "messages": [
        {
          "type": "command",
          "name": "Pick Order"
        }
      ]
    },
    {
      "collaborator": {
        "name": "Carriers",
        "kind": "external-system"
      },
      "relationship": {
        "theirs": "published-language",
        "ours": "published-language"
      },
      "messages": [
        {
          "type": "command",
          "name": "Book Shipment"
        },
        {
          "type": "query",
          "name": "Get Tracking Status"
        }
      ]
    },
    {
      "collaborator": {
        "name": "Notifications",
        "kind": "bounded-context"
      },
      "messages": [
        {
          "type": "event",
          "name": "Order Shipped"
        }
      ]
    }
  ],
  "assumptions": [
    "Warehouse stock counts are accurate within the hour.",
    "A single warehouse serves all orders."
  ],
  "verificationMetrics": [
    "95% of paid orders dispatch within 4 hours.",
    "Under 1% of orders are cancelled after picking starts."
  ],
  "openQuestions": [
    "Who owns returns — this context or a new one?",
    "Do pre-orders belong here or in Checkout?"
  ]
}
