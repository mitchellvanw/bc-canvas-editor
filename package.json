{
	"name": "bc-canvas-editor",
	"private": true,
	"version": "0.0.1",
	"description": "Editor, CLI, MCP server and fence adapters for the Bounded Context Canvas",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mitchellvanw/bc-canvas-editor.git"
	},
	"engines": {
		"node": ">=26"
	},
	"type": "module",
	"bin": {
		"bcc": "./cli/dist/bcc.js"
	},
	"exports": {
		"./remark": "./remark/dist/plugin.js",
		"./sheet.css": "./remark/dist/sheet.css"
	},
	"files": [
		"cli/dist",
		"remark/dist"
	],
	"scripts": {
		"dev": "cd web && vite dev",
		"build": "cd web && vite build",
		"build:render": "node web/src/lib/render/build.js",
		"build:cli": "node cli/build.js",
		"build:remark": "node remark/build.js",
		"build:vscode": "node vscode/build.mjs",
		"build:bundles": "npm run build:render && npm run build:cli && npm run build:remark && npm run build:vscode",
		"bcc": "node cli/dist/bcc.js",
		"preview": "cd web && vite preview",
		"prepare": "cd web && svelte-kit sync || echo ''",
		"test": "vitest run",
		"test:mcp": "npm test --prefix mcp",
		"check": "cd web && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:cli": "tsc --noEmit -p cli/tsconfig.json",
		"check:remark": "tsc --noEmit -p remark/tsconfig.json",
		"check:vscode": "tsc --noEmit -p vscode/tsconfig.json",
		"check:watch": "cd web && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"proto:seam": "cd web && vite dev --open /proto-docs-seam"
	},
	"devDependencies": {
		"@fontsource/archivo": "^5.3.0",
		"@fontsource/ibm-plex-mono": "^5.3.0",
		"@fontsource/source-serif-4": "^5.3.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.2.0",
		"@types/vscode": "~1.90.0",
		"@zumer/snapdom": "^2.23.2",
		"esbuild": "^0.27.7",
		"jsdom": "^30.0.1",
		"playwright-core": "^1.58.0",
		"rehype-raw": "^7.0.0",
		"rehype-slug": "^6.0.0",
		"rehype-stringify": "^10.0.1",
		"remark-directive": "^4.0.0",
		"remark-gfm": "^4.0.1",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.2",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"unified": "^11.0.5",
		"vite": "^8.0.16",
		"vitest": "^4.1.10"
	}
}
